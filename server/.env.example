PORT=8000
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/engram?retryWrites=true&w=majority"
JWT_SECRET="replace-with-a-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# WhatsApp Cloud API Credentials (Meta Developer Dashboard)
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token"
WHATSAPP_APP_SECRET="your_meta_app_secret_from_dashboard"
WHATSAPP_TOKEN="your_meta_system_user_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_meta_whatsapp_phone_number_id"
