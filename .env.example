# Server Configuration
PORT=8000

# Meta WhatsApp Config (Fill these in from the Meta Developer Console)
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here   # you choose this string

# Database Config
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/engram?retryWrites=true&w=majority

# Other Secrets
JWT_SECRET=your_jwt_secret_here
